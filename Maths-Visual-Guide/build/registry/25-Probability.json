   "short": "Probability",
   "page": 4
  },
  {
   "word": "independent events",
   "meaning": "knowing one happened doesn't change the other's probability; then p(E and F) = p(E) \u00d7 p(F)",
   "ch": 25,
   "short": "Probability",
   "page": 5
  },
  {
   "word": "two-way table",
   "meaning": "a table counting every combination of two characteristics, with totals in the margins",
   "ch": 25,
   "short": "Probability",
   "page": 8
  },
  {
   "word": "marginal probability",
   "meaning": "the overall probability of one characteristic, from a margin total",
   "ch": 25,
   "short": "Probability",
   "page": 8
  },
  {
   "word": "Bayes' theorem",
   "meaning": "p(a|b) = p(b|a) p(a) / p(b): turns one conditional probability round",
   "ch": 25,
   "short": "Probability",
   "page": 10
  },
  {
   "word": "tree diagram",
   "meaning": "branches for each outcome of each stage; multiply along a path, add between paths",
   "ch": 25,
   "short": "Probability",
   "page": 11
  },
  {
   "word": "law of total probability",
   "meaning": "p(B) = p(B|A)p(A) + p(B|A\u2032)p(A\u2032): add up every way B can happen",
   "ch": 25,
   "short": "Probability",
   "page": 11
  },
  {
   "word": "prior probability",
   "meaning": "the probability before new evidence, e.g. p(cancer) = 1%",
   "ch": 25,
   "short": "Probability",
   "page": 14
  },
  {
   "word": "posterior probability",
   "meaning": "the updated probability after the evidence, e.g. p(cancer | positive) = 7.8%",
   "ch": 25,
   "short": "Probability",
   "page": 14
  }
 ],
