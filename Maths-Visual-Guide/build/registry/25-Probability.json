   "short": "Probability",
   "page": 2
  },
  {
   "word": "complement rule",
   "meaning": "p(E doesn't happen) = 1 \u2212 p(E)",
   "ch": 25,
   "short": "Probability",
   "page": 2
  },
  {
   "word": "joint probability",
   "meaning": "the probability that two events both happen, p(E \u2229 F)",
   "ch": 25,
   "short": "Probability",
   "page": 3
  },
  {
   "word": "addition rule",
   "meaning": "p(E or F) = p(E) + p(F) \u2212 p(E and F)",
   "ch": 25,
   "short": "Probability",
   "page": 3
  },
  {
   "word": "mutually exclusive",
   "meaning": "events that cannot both happen: p(E and F) = 0",
   "ch": 25,
   "short": "Probability",
   "page": 3
  },
  {
   "word": "conditional probability",
   "meaning": "p(E | F): the probability of E once you know F happened; F becomes the new sample space",
