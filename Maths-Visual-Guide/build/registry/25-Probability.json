  },
  {
   "latex": "p(A\\cup B)=p(A)+p(B)-p(A\\cap B)",
   "label": "Addition rule (OR)",
   "ch": 25,
   "short": "Probability",
   "page": 15
  },
  {
   "latex": "p(A\\cap B)=0,\\qquad p(A\\cup B)=p(A)+p(B)",
