 "formulas": [
  {
   "latex": "f(x)=\\frac{1}{\\sigma\\sqrt{2\\pi}}e^{-\\frac12\\left(\\frac{x-\\mu}{\\sigma}\\right)^2}",
   "label": "Normal curve",
   "ch": 26,
   "short": "Normal distribution",
   "page": 4
  },
  {
   "latex": "z=\\frac{x-\\mu}{\\sigma}",
   "label": "z-score",
   "ch": 26,
   "short": "Normal distribution",
   "page": 6
  },
  {
   "latex": "x=\\mu+z\\sigma,\\qquad \\mu=x-z\\sigma,\\qquad \\sigma=\\frac{x-\\mu}{z}",
   "label": "Back from z",
   "ch": 26,
   "short": "Normal distribution",
   "page": 15
  },
  {
   "latex": "p(X<x)=\\Phi(z)",
   "label": "Below a value",
   "ch": 26,
   "short": "Normal distribution",
   "page": 15
  },
  {
   "latex": "p(X>x)=1-\\Phi(z)",
   "label": "Above a value",
   "ch": 26,
   "short": "Normal distribution",
   "page": 15
  },
  {
   "latex": "p(a<X<b)=\\Phi(z_b)-\\Phi(z_a)",
   "label": "Between two values",
   "ch": 26,
   "short": "Normal distribution",
   "page": 15
  },
  {
