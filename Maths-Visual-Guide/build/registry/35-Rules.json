 "formulas": [
  {
   "latex": "\\frac{dy}{dx}=\\frac{dy}{dz}\\times\\frac{dz}{dx}",
   "label": "chain rule",
   "ch": 35,
   "short": "Rules",
   "page": 4
  },
  {
   "latex": "\\frac{d(uv)}{dx}=v\\frac{du}{dx}+u\\frac{dv}{dx}",
   "label": "product rule",
   "ch": 35,
   "short": "Rules",
   "page": 8
  },
  {
   "latex": "\\frac{d}{dx}\\left(\\frac uv\\right)=\\frac{v\\frac{du}{dx}-u\\frac{dv}{dx}}{v^2}",
   "label": "quotient rule",
   "ch": 35,
   "short": "Rules",
   "page": 10
  },
  {
   "latex": "\\frac{d^2y}{dx^2}=\\frac{d}{dx}\\left(\\frac{dy}{dx}\\right)",
   "label": "Higher derivatives",
   "ch": 35,
   "short": "Rules",
   "page": 17
  },
  {
   "latex": "\\frac{dy}{dx}=\\frac{dy}{du}\\times\\frac{du}{dx}",
   "label": "Chain rule",
   "ch": 35,
   "short": "Rules",
   "page": 17
  },
  {
   "latex": "\\frac{d}{dx}\\big(g(x)\\big)^n=n\\big(g(x)\\big)^{n-1}g'(x)",
   "label": "Chain: powers",
   "ch": 35,
   "short": "Rules",
   "page": 17
  },
  {
   "latex": "\\frac{d}{dx}e^{g(x)}=g'(x)e^{g(x)},\\qquad\\frac{d}{dx}\\ln g(x)=\\frac{g'(x)}{g(x)}",
   "label": "Chain: e and ln",
   "ch": 35,
   "short": "Rules",
   "page": 17
  },
  {
   "latex": "\\frac{d}{dx}\\sqrt{g(x)}=\\frac{g'(x)}{2\\sqrt{g(x)}}",
   "label": "Chain: roots",
   "ch": 35,
   "short": "Rules",
   "page": 17
  },
  {
   "latex": "\\frac{d}{dx}\\big(kf(x)\\big)=kf'(x)",
