  {
   "word": "logarithm",
   "meaning": "log_b N is the power you must raise b to, to get N; it counts how many b's multiply to N",
   "ch": 22,
   "short": "Logarithms",
   "page": 2
  },
  {
   "word": "base (of a log)",
   "meaning": "the number being raised to a power, written small: the 2 in log\u2082 8",
   "ch": 22,
   "short": "Logarithms",
   "page": 2
  },
  {
   "word": "common log",
   "meaning": "log to base 10, the log button: log 1000 = 3",
   "ch": 22,
   "short": "Logarithms",
   "page": 3
  },
  {
   "word": "natural log",
   "meaning": "log to base e (2.718...), written ln: ln e = 1",
   "ch": 22,
   "short": "Logarithms",
   "page": 3
  },
  {
   "word": "log scale",
   "meaning": "a scale where equal steps mean multiplying by the same amount (e.g. \u00d710)",
   "ch": 22,
   "short": "Logarithms",
   "page": 4
  },
  {
   "word": "laws of logs",
   "meaning": "log(ab) = log a + log b, log(a/b) = log a \u2212 log b, log a\u207f = n log a (any base)",
   "ch": 22,
   "short": "Logarithms",
   "page": 5
  },
  {
   "word": "solving exponential equations",
   "meaning": "take logs of both sides and use log a\u207f = n log a to bring the unknown down",
   "ch": 22,
   "short": "Logarithms",
   "page": 7
  }
 ],
